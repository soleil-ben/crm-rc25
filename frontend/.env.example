# Solaris Express CRM - frontend environment
# Copy to frontend/.env for local overrides. NEVER commit frontend/.env.
#
# The frontend holds NO secrets. The staff session is an HTTP-only cookie the
# browser manages; no token is ever read or stored by this application.

# Dev-server proxy target for /api. Requests stay same-origin in the browser so
# the session cookie is sent without a cross-site cookie relaxation.
VITE_API_TARGET=http://127.0.0.1:8000
