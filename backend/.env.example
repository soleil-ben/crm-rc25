# Solaris Express CRM - backend environment
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# Every value below is a placeholder.

# --- Environment -------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Database ----------------------------------------------------------
# The SQLite file must live OUTSIDE the source tree. The default resolves to
# <repo>/data/solaris_crm.db, which is git-ignored along with its -wal/-shm files.
# DATABASE_URL=sqlite:////absolute/path/to/data/solaris_crm.db
SQLITE_BUSY_TIMEOUT_MS=5000

# --- Security ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The application refuses to start in production while this is the dev default.
SECRET_KEY=replace-me-with-a-long-random-value

SESSION_IDLE_MINUTES=480
SESSION_ABSOLUTE_HOURS=24

# Must be true in production (enforced at startup).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=crm.example.com

# --- CORS --------------------------------------------------------------
# Comma-separated exact origins. Never use "*" with credentialed cookies.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limits -------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PUBLIC_TRACKING_RATE_LIMIT_ATTEMPTS=30
PUBLIC_TRACKING_RATE_LIMIT_WINDOW_SECONDS=60

# Whether a forwarding header may be believed when identifying a client.
#
# Keep this false until a specific reverse proxy is deployed AND the ASGI server is told
# to trust only that proxy's address. Uvicorn enables --proxy-headers by default and
# trusts 127.0.0.1, so it rewrites the peer address from X-Forwarded-For before the
# application sees it -- run it with --no-proxy-headers until then. While this is false,
# every public request carrying a forwarding header shares one rate-limit bucket, so a
# spoofer cannot mint a fresh allowance per request whatever the server did (DEC-0048).
TRUST_PROXY_HEADERS=false

# --- Business defaults -------------------------------------------------
DEFAULT_TIMEZONE=America/Toronto
DEFAULT_CURRENCY=CAD

# Public tracking base URL encoded into every label QR code.
# The PATH must stay /track: that is the route the public application serves, and a QR is
# printed on a parcel weeks before anyone checks it. The production DOMAIN is NOT assumed
# to exist; confirm before printing labels that reach a customer.
TRACKING_BASE_URL=http://localhost:5173/track

# --- Public tracking page ----------------------------------------------
# Contact link shown on the public page. Empty means the link is omitted rather than
# pointing somewhere invented.
PUBLIC_HELP_URL=

# Hosts a stored carrier link may use before the public page will render it. The link is
# DISPLAYED ONLY and is never fetched server-side. Empty means no carrier link is ever
# shown. These defaults are plausible, not verified -- review them before production.
PUBLIC_CARRIER_LINK_HOSTS=www.ups.com,www.fedex.com,www.purolator.com,www.canadapost-postescanada.ca,www.dhl.com,tools.usps.com,www.usps.com,vnpost.vn,viettelpost.com.vn

# --- Demo data guard ---------------------------------------------------
# Must be false in production (enforced at startup). Guards `python -m app.seed`.
ALLOW_DEMO_SEED=true

# --- Provider integrations ---------------------------------------------
#
# NO PROVIDER IS CONNECTED. The adapter registry is empty, connected_api is refused, and
# no request has ever been made to a carrier or to ShipStation by this application.
#
# Credentials are read server-side only and are never returned by the API. Nothing below
# is required: a missing API key must never prevent the CRM, manual milestones, or label
# printing from working (CRM.md section 3).
#
# Leave the commented placeholders commented until the ShipStation product, API
# generation, and entitlements are verified against the real account. Legacy ShipStation,
# ShipStation V2, and ShipStation API / ShipEngine are NOT interchangeable
# (docs/INTEGRATIONS.md section 9 lists the nine questions).
# SHIPSTATION_API_KEY=
# SHIPSTATION_API_SECRET=
# SHIPSTATION_WEBHOOK_SECRET=

# --- Integration infrastructure (Phase 4A) -----------------------------
# Bounds the durable inbox and the worker operate under. None of these configures a
# provider.

# Largest webhook body accepted. A larger delivery is REFUSED and stored as a digest with
# no body -- never truncated, because a truncated payload parses into something the
# provider did not send.
INTEGRATION_WEBHOOK_MAX_BYTES=262144
INTEGRATION_WEBHOOK_CONTENT_TYPES=application/json

# How long a worker may hold a claimed job before the lease expires and another worker may
# reclaim it. This is what stops a crashed worker stranding work.
INTEGRATION_JOB_LEASE_SECONDS=300

# Attempts before a retryable job stops and goes to the failed-job review queue.
INTEGRATION_JOB_MAX_ATTEMPTS=5
# Attempts before an AUTHENTICATION failure stops. Deliberately far lower: repeating a
# rejected credential achieves nothing and can lock an account.
INTEGRATION_AUTH_MAX_ATTEMPTS=2

# Exponential backoff with full jitter. The maximum also caps a provider Retry-After, so a
# provider cannot park a job indefinitely.
INTEGRATION_RETRY_BASE_SECONDS=30
INTEGRATION_RETRY_MAX_SECONDS=3600

INTEGRATION_WORKER_BATCH_SIZE=20
INTEGRATION_WORKER_POLL_SECONDS=15

# Hosts and path prefixes a provider resource_url may be fetched from.
#
# BOTH ARE EMPTY, AND MUST STAY EMPTY until official documentation and the real account
# confirm which hosts and paths a fetch would need. An empty allowlist refuses everything,
# which is the correct behaviour for a provider nobody has verified, and a test fails if a
# plausible guess is added. Matching is EXACT -- never a suffix.
INTEGRATION_RESOURCE_ALLOWED_HOSTS=
INTEGRATION_RESOURCE_ALLOWED_PATH_PREFIXES=

# --- Customer Account (Phase 9) ----------------------------------------
#
# The authenticated customer surface. Nothing here is shared with the staff realm: the
# cookie names, the CSRF header, the session table, the resolver, the dependencies and the
# rate-limit key namespace are all separate (DEC-0090). The cookie names are deliberately
# NOT configurable -- differing from the staff names is a security property, not a
# preference.
#
# REGISTRATION CANNOT LAUNCH IN PRODUCTION. Two owner decisions gate it and both are
# enforced by the application: OD-34 (no email provider selected) and OD-37 (no approved
# terms and privacy text). See docs/OPERATIONS.md sections 6 and 12.

# Which EmailTransport to build. Three names and no fourth:
#   null        records that a send was requested and produces nothing (the default)
#   capture     writes local files, opens no socket -- development and UAT only
#   production  NOT IMPLEMENTED; selecting it FAILS AT STARTUP (OD-34)
# There is deliberately no value meaning "production if configured, capture otherwise":
# a silent fallback is how a deployment writes verification links to a directory while
# customers wait for mail nobody sent.
ACCOUNT_EMAIL_TRANSPORT=null

# Where the capture writes. Defaults to <repo>/data/account_mail, which is git-ignored.
# Captured messages contain verification and reset links IN PLAINTEXT, which is why no HTTP
# route returns them and why this transport is refused at startup in production.
ACCOUNT_EMAIL_CAPTURE_DIR=

# Development and UAT only: behave as production does with no email provider selected
# (OD-34). Registration, resend and password reset refuse with the "accounts are not open
# yet" answer; sign-in still works. Used for UAT case CA-REG-09 (docs/UAT/ENVIRONMENT.md
# section 3b). It can only close registration, never open it.
ACCOUNT_REHEARSE_NO_EMAIL_PROVIDER=false

# Terms and privacy versions recorded on every acknowledgement (OD-37). Both ship as values
# that name themselves placeholders, and production registration REFUSES while either still
# does -- an acknowledgement recorded against a placeholder is an acknowledgement of nothing.
ACCOUNT_TERMS_VERSION=PLACEHOLDER-terms-unapproved
ACCOUNT_PRIVACY_VERSION=PLACEHOLDER-privacy-unapproved

# Sessions. Idle is shorter than the staff 480: a customer session is often on a shared or
# mobile device and is used briefly.
ACCOUNT_SESSION_IDLE_MINUTES=60
ACCOUNT_SESSION_ABSOLUTE_HOURS=24

# Tokens. Hours, not days (OD-36), and enforced server-side on every redemption.
ACCOUNT_VERIFICATION_TOKEN_HOURS=24
ACCOUNT_PASSWORD_RESET_TOKEN_HOURS=1

# Length only. Composition rules push people toward Password1!, which is in every corpus.
ACCOUNT_MIN_PASSWORD_LENGTH=12

# Rate limits, in the `account:` namespace so a customer-side flood can never consume the
# staff login or public tracking allowance. Starting values, not measurements.
#
# Note the two per-address buckets: when they refuse, the endpoint returns the ORDINARY
# generic body rather than a 429, and simply sends nothing. A 429 that appeared only for
# addresses somebody kept trying would itself be an enumeration signal.
ACCOUNT_REGISTER_IP_ATTEMPTS=5
ACCOUNT_REGISTER_IP_WINDOW_SECONDS=3600
ACCOUNT_REGISTER_ADDRESS_ATTEMPTS=2
ACCOUNT_REGISTER_ADDRESS_WINDOW_SECONDS=86400
ACCOUNT_RESEND_IP_ATTEMPTS=5
ACCOUNT_RESEND_IP_WINDOW_SECONDS=3600
ACCOUNT_RESEND_ADDRESS_ATTEMPTS=3
ACCOUNT_RESEND_ADDRESS_WINDOW_SECONDS=3600
ACCOUNT_SIGNIN_IP_ATTEMPTS=10
ACCOUNT_SIGNIN_IP_WINDOW_SECONDS=300
ACCOUNT_SIGNIN_ADDRESS_ATTEMPTS=6
ACCOUNT_SIGNIN_ADDRESS_WINDOW_SECONDS=900
ACCOUNT_RESET_IP_ATTEMPTS=5
ACCOUNT_RESET_IP_WINDOW_SECONDS=3600
ACCOUNT_RESET_ADDRESS_ATTEMPTS=3
ACCOUNT_RESET_ADDRESS_WINDOW_SECONDS=3600
ACCOUNT_TOKEN_IP_ATTEMPTS=20
ACCOUNT_TOKEN_IP_WINDOW_SECONDS=600
ACCOUNT_TOKEN_IDENTITY_ATTEMPTS=10
ACCOUNT_TOKEN_IDENTITY_WINDOW_SECONDS=3600

# Per-identity lockout: failures, the window they must fall inside, and how long it lasts.
# Bounded in time and never permanent -- a permanent lockout hands an attacker a way to
# disable any customer whose address they can guess.
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_WINDOW_MINUTES=15
ACCOUNT_LOCKOUT_MINUTES=15

# Largest Customer Account request body. Far below MAX_REQUEST_BYTES: none of these
# endpoints accepts a file and a registration form is a few hundred bytes.
ACCOUNT_MAX_BODY_BYTES=16384

# English only for release 1 (OD-39). Vietnamese customer-account wording stays disabled
# until a qualified reviewer approves all four categories.
ACCOUNT_SUPPORTED_LANGUAGES=en
