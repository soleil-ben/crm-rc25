# UAT-safe settings for the portable RC-UAT-25 package. Loaded by uat\uat.ps1 into the
# process environment only; no backend\.env is ever written or read.
# No secrets here: SECRET_KEY is generated per PC into uat\uat.local.env on first start.
# The database, captured-mail and rate-email paths are set by uat.ps1 under data\uat\.

ENVIRONMENT=development
DEBUG=false
ALLOW_DEMO_SEED=true

# Email never leaves this PC: "capture" writes each message as a file in data\uat\account_mail.
ACCOUNT_EMAIL_TRANSPORT=capture

# Customer Account: Vietnamese first, English switch (OD-71).
ACCOUNT_SUPPORTED_LANGUAGES=vi,en

# Local addresses only.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRACKING_BASE_URL=http://localhost:5173/track
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

DEFAULT_TIMEZONE=America/Toronto
DEFAULT_CURRENCY=CAD
